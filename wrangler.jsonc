{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mukkonz-os",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mukkonz-db",
      "database_id": "0b311847-3c51-4aae-9dbd-e320ead9dd0d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "mukkonz-attachments"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LIMITS",
      "id": "df6901add4f944eca529cef6db84a78b"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
